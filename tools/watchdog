#!/usr/bin/env bash
# Health check for the capture pipeline. Prints one line per problem and exits
# non-zero if any were found; silent and exit 0 when healthy.
#
#   tools/watchdog          check only
#   tools/watchdog --heal   also repair what it finds: restart a stalled
#                           publisher, or re-queue a stranded queue head
#
# The interesting check is the publisher one. Malcolm's pcap-monitor runs two
# independent processes:
#
#   watch-upload     moves pcap/upload -> pcap/processed
#   pcap-publisher   watches pcap/processed and notifies Zeek/Suricata/Arkime
#
# The publisher can stop emitting while its process stays alive, logs no error,
# and the container keeps reporting healthy. The mover carries on, so captures
# still flow across the disk and nothing looks wrong - but nothing is analysed
# and every new packet is silently discarded from the index. Comparing the
# newest processed capture against the last publish is what catches it.
#
# Do NOT alert on a flat document count alone: an idle network legitimately
# produces no new documents, and a date-pinned index name stops growing at every
# UTC midnight rollover even though ingestion is perfectly healthy.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OSAPI="${HERE}/osapi"

MALCOLM_DIR="${MALCOLM_DIR:-${HOME}/malcolm}"
PCAP_MOUNT="${PCAP_MOUNT:-//d/malcolm-data/pcap}"
ZEEK_MOUNT="${ZEEK_MOUNT:-//d/malcolm-data/zeek-logs}"
MONITOR_CONTAINER="${MONITOR_CONTAINER:-malcolm-pcap-monitor-1}"
SENSOR_CONTAINER="${SENSOR_CONTAINER:-er4-sensor}"
STALL_SECS="${STALL_SECS:-420}"
# Where the head-of-queue tracking state lives (needed to spot a stranded head).
STATE_DIR="${STATE_DIR:-${TMPDIR:-/tmp}/er4-watchdog}"
mkdir -p "$STATE_DIR"
HEAL=0; [[ "${1:-}" == "--heal" ]] && HEAL=1

problems=0
report() { echo "$*"; problems=$((problems + 1)); }

health=$("$OSAPI" es GET _cluster/health 2>/dev/null \
  | python3 -c "import sys,json;print(json.load(sys.stdin).get('status','UNREACHABLE'))" 2>/dev/null) \
  || health=UNREACHABLE
[[ "$health" == "green" ]] || report "CLUSTER ${health:-UNREACHABLE}"

docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$SENSOR_CONTAINER" \
  || report "SENSOR DOWN (${SENSOR_CONTAINER} not running)"

unhealthy=$(cd "$MALCOLM_DIR" && docker compose ps --format '{{.Name}} {{.Status}}' 2>/dev/null \
            | grep -viE 'healthy|Up [0-9]+ (second|minute)s? \(health: starting\)' | head -3)
[[ -n "$unhealthy" ]] && report "UNHEALTHY: $(echo "$unhealthy" | tr '\n' ';')"

# Newest capture that reached processed/, as epoch seconds.
newest=$(docker run --rm -v "${PCAP_MOUNT}:/p" alpine sh -c \
  'ls -t /p/processed/*.pcap 2>/dev/null | head -1 | xargs -r stat -c %Y' 2>/dev/null)

# When the publisher last announced a file to the analysers.
last_pub=$(docker logs --since 30m "$MONITOR_CONTAINER" 2>&1 | grep -F '📫' | tail -1 \
           | grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}')
last_pub_epoch=$([[ -n "$last_pub" ]] && date -u -d "$last_pub" +%s 2>/dev/null || echo 0)

if [[ -n "${newest:-}" && "${newest:-0}" -gt 0 ]]; then
  lag=$(( newest - last_pub_epoch ))
  if [[ "$last_pub_epoch" -eq 0 || "$lag" -gt "$STALL_SECS" ]]; then
    report "PUBLISHER STALLED (captures arriving, last publish ${lag}s older than newest capture)"
    if [[ "$HEAL" -eq 1 ]]; then
      echo "  healing: restarting ${MONITOR_CONTAINER}"
      (cd "$MALCOLM_DIR" && docker compose --profile malcolm restart pcap-monitor >/dev/null 2>&1) \
        && echo "  restarted - re-queue any unanalysed captures from processed/ into upload/"
    fi
  fi
fi

# Queue-age checks. The pipeline is a chain of spool directories, each drained
# by a watcher process, and EVERY one of those watchers has been observed to
# stop silently while alive and healthy. Checking only one stage misses the
# others - this was learned by fixing the pcap publisher and then finding
# filebeat's zeek-tarball extractor stalled in exactly the same way.
#
# Depth alone is a bad signal: a deep queue that is moving is fine. The age of
# the OLDEST pending item is the honest one - if nothing has drained the head of
# the queue in STALL_SECS, that stage is stuck.
check_queue() { # check_queue <label> <mount> <glob-dir> <service-to-restart>
  local label="$1" mount="$2" dir="$3" svc="$4"
  local oldest count
  # Age comes from the capture timestamp in the FILENAME, not mtime. mtime is
  # not trustworthy here: touching a stuck file resets it, which hides the stall
  # from this very check while the file remains stuck. (Learned the hard way -
  # touch also does not unstick it, see GOTCHAS.)
  read -r count oldest < <(docker run --rm -v "${mount}:/q" alpine sh -c \
    "ls -1 /q/${dir} 2>/dev/null | wc -l
     for f in \$(ls -1 /q/${dir} 2>/dev/null); do
       b=\$(basename \"\$f\"); case \"\$b\" in
         *20[0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]*)
           echo \"\$b\" | sed 's/.*\\(20[0-9]\\{6\\}\\)-\\([0-9]\\{6\\}\\).*/\\1\\2/' ;;
         *) date -u -r \"\$f\" +%Y%m%d%H%M%S 2>/dev/null || stat -c %Y \"\$f\" ;;
       esac
     done | sort | head -1" 2>/dev/null | paste -sd' ')
  [[ -z "${oldest:-}" || "${#oldest}" -ne 14 ]] && return 0
  local oldest_epoch age
  oldest_epoch=$(date -u -d "${oldest:0:8} ${oldest:8:2}:${oldest:10:2}:${oldest:12:2}" +%s 2>/dev/null) || return 0
  age=$(( $(date -u +%s) - oldest_epoch ))
  [[ "$age" -le "$STALL_SECS" ]] && return 0

  # A deep queue is not the same as a stopped one. After a stall the backlog can
  # be hours old while the consumer works through it perfectly well - restarting
  # then is actively harmful: each restart costs the startup delay and drops
  # whatever was in flight, so a 5-minute heal loop can keep a queue permanently
  # backlogged. Only restart when nothing is draining.
  local drained
  drained=$(docker logs --since 5m "$(drain_container "$svc")" 2>&1 | grep -cE '🖅|📫' || true)

  # ...but "draining" is not the same as "making progress". The watchers only
  # act on *created* events, so anything already present when one starts is
  # skipped forever while new arrivals sail past it. The queue then looks busy
  # and healthy - events flowing, count roughly stable - with a permanently
  # stranded head. 68 tarballs sat like that for four hours.
  #
  # The tell is the OLDEST entry never changing. Track it across runs.
  local state="${STATE_DIR}/$(echo "$label" | tr '/' '_').oldest"
  local prev=""; [[ -f "$state" ]] && prev=$(cat "$state")
  echo "$oldest" > "$state"

  if [[ -n "$prev" && "$prev" == "$oldest" && "$count" -gt 0 ]]; then
    report "QUEUE HEAD STUCK: ${label} (${count} pending, head unchanged at ${oldest}, ${age}s old)"
    # A restart does NOT fix this - the files are still pre-existing to the
    # restarted watcher. Re-present them as new instead.
    if [[ "$HEAL" -eq 1 ]]; then
      echo "  healing: re-queuing stranded entries in ${label}"
      docker run --rm -v "${mount}:/q" alpine sh -c \
        "mkdir -p /q/.requeue
         for f in /q/${dir}; do [ -f \"\$f\" ] || continue; mv \"\$f\" /q/.requeue/ 2>/dev/null; done
         sleep 20
         for f in /q/.requeue/*; do [ -f \"\$f\" ] || continue; mv \"\$f\" /q/$(dirname "$dir")/ 2>/dev/null; done
         rmdir /q/.requeue 2>/dev/null; true" >/dev/null 2>&1
      echo "  re-queued - watchers see them as new files now"
    fi
    return 0
  fi

  if [[ "${drained:-0}" -gt 0 ]]; then
    report "QUEUE BACKLOG: ${label} (${count} pending, oldest capture ${age}s old; draining - ${drained} events/5m, head advancing)"
    return 0
  fi

  report "QUEUE STALLED: ${label} (${count} pending, oldest capture ${age}s old, no drain activity)"
  if [[ "$HEAL" -eq 1 && -n "$svc" ]]; then
    echo "  healing: restarting ${svc}"
    (cd "$MALCOLM_DIR" && docker compose --profile malcolm restart "$svc" >/dev/null 2>&1)
  fi
}

drain_container() { # map a compose service to its container name
  case "$1" in
    filebeat)     echo "malcolm-filebeat-1" ;;
    pcap-monitor) echo "$MONITOR_CONTAINER" ;;
    *)            echo "malcolm-${1}-1" ;;
  esac
}

check_queue "pcap/upload"      "$PCAP_MOUNT" "upload/*.pcap"    "pcap-monitor"
check_queue "zeek-logs/upload" "$ZEEK_MOUNT" "upload/*.tar.gz" "filebeat"

exit $(( problems > 0 ))
