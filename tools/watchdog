#!/usr/bin/env bash
# Health check for the capture pipeline. Prints one line per problem and exits
# non-zero if any were found; silent and exit 0 when healthy.
#
#   tools/watchdog          check only
#   tools/watchdog --heal   also repair what it finds: restart a stalled
#                           publisher, or re-queue a stranded queue head
#
# The interesting check is the publisher one. Malcolm's pcap-monitor runs two
# independent processes:
#
#   watch-upload     moves pcap/upload -> pcap/processed
#   pcap-publisher   watches pcap/processed and notifies Zeek/Suricata/Arkime
#
# The publisher can stop emitting while its process stays alive, logs no error,
# and the container keeps reporting healthy. The mover carries on, so captures
# still flow across the disk and nothing looks wrong - but nothing is analysed
# and every new packet is silently discarded from the index. Comparing the
# newest processed capture against the last publish is what catches it.
#
# Do NOT alert on a flat document count alone: an idle network legitimately
# produces no new documents, and a date-pinned index name stops growing at every
# UTC midnight rollover even though ingestion is perfectly healthy.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OSAPI="${HERE}/osapi"
# Reads config.env without clobbering an explicit `VAR=x tools/watchdog`.
# Without this the paths below ignored DATA_ROOT entirely: relocate the data and
# the watchdog keeps checking the old directory and calls it healthy.
. "${HERE}/_config.sh"

MALCOLM_DIR="${MALCOLM_DIR:-${HOME}/malcolm}"
PCAP_MOUNT="${PCAP_MOUNT:-//d/malcolm-data/pcap}"
ZEEK_MOUNT="${ZEEK_MOUNT:-//d/malcolm-data/zeek-logs}"
# Compose derives the project name from the directory it runs in, and container
# names are "<project>-<service>-1". Install to a differently-named directory and
# every hardcoded "malcolm-*" lookup silently finds nothing — which here would
# read as "the consumer emitted no events", i.e. a false stall on every check.
COMPOSE_PROJECT="${COMPOSE_PROJECT:-$(basename "$MALCOLM_DIR")}"
MONITOR_CONTAINER="${MONITOR_CONTAINER:-${COMPOSE_PROJECT}-pcap-monitor-1}"
SENSOR_CONTAINER="${SENSOR_CONTAINER:-er4-sensor}"
STALL_SECS="${STALL_SECS:-420}"
# Where the head-of-queue tracking state lives (needed to spot a stranded head).
STATE_DIR="${STATE_DIR:-${TMPDIR:-/tmp}/er4-watchdog}"
mkdir -p "$STATE_DIR"
HEAL=0; [[ "${1:-}" == "--heal" ]] && HEAL=1

# Warn before memory pressure corrupts an index, not after.
#
# OpenSearch reports an out-of-memory host as a CORRUPT INDEX: a flush fails to
# read its segment infos, and Lucene raises CorruptIndexException whose innermost
# cause is "Cannot allocate memory". The shard is then unassignable and the data
# is gone. That happened here to arkime_stats at 143 MB free with 13.5 GB of
# 16 GB swap in use, and the first warning of any kind was a red cluster.
#
# It is worth warning early because the loss is not recoverable and the next
# index to be hit may be a session index rather than a stats one.
MEM_WARN_MB="${MEM_WARN_MB:-2048}"       # available memory below this is dangerous
SWAP_WARN_PCT="${SWAP_WARN_PCT:-85}"     # swap this full means the host is already thrashing
problems=0
report() { echo "$*"; problems=$((problems + 1)); }

if [[ -r /proc/meminfo ]]; then
  mem_avail=$(awk '/^MemAvailable:/{print int($2/1024)}' /proc/meminfo)
  swap_total=$(awk '/^SwapTotal:/{print int($2/1024)}' /proc/meminfo)
  swap_free=$(awk '/^SwapFree:/{print int($2/1024)}' /proc/meminfo)
  swap_pct=0
  [[ "${swap_total:-0}" -gt 0 ]] && swap_pct=$(( (swap_total - swap_free) * 100 / swap_total ))

  if [[ "${mem_avail:-99999}" -lt "$MEM_WARN_MB" ]]; then
    report "MEMORY LOW (${mem_avail}MB available, swap ${swap_pct}% used) - OpenSearch reports this as index corruption, not as an OOM"
  elif [[ "${swap_pct:-0}" -ge "$SWAP_WARN_PCT" ]]; then
    report "SWAP PRESSURE (${swap_pct}% of swap in use, ${mem_avail}MB available) - a flush failing here corrupts a shard irrecoverably"
  fi
fi

# Cluster health, with transient recovery separated from actual degradation.
#
# "not green" is not the same as "broken". A shard being created or recovering
# makes the cluster red for a few seconds - routine index rollover does it - and
# alerting on that trains you to ignore the alert that matters. Observed: a red
# alert fired for one initializing shard, 0 unassigned, and the cluster was green
# again inside a minute.
#
# The discriminator is unassigned_shards. Unassigned means data is genuinely
# unavailable right now: alert immediately. Initializing or relocating with none
# unassigned is recovery in progress, so require it to still be non-green on the
# NEXT run before saying anything - the same two-observation rule the stuck-head
# check uses below.
read -r health unassigned initializing < <("$OSAPI" es GET _cluster/health 2>/dev/null \
  | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(d.get('status','UNREACHABLE'),
          d.get('unassigned_shards',0),
          d.get('initializing_shards',0) + d.get('relocating_shards',0))
except Exception:
    print('UNREACHABLE 0 0')
" 2>/dev/null) || { health=UNREACHABLE; unassigned=0; initializing=0; }

cstate="${STATE_DIR}/cluster.notgreen"
if [[ "$health" == "green" ]]; then
  rm -f "$cstate"
elif [[ "$health" == "UNREACHABLE" ]]; then
  rm -f "$cstate"
  report "CLUSTER UNREACHABLE (no health response from OpenSearch)"
elif [[ "${unassigned:-0}" -gt 0 ]]; then
  rm -f "$cstate"
  report "CLUSTER ${health} (${unassigned} shards unassigned - data unavailable)"
elif [[ -f "$cstate" ]]; then
  report "CLUSTER ${health} for two consecutive checks (${initializing:-0} shards still recovering)"
else
  # First sighting of a recovering cluster. Stay quiet; if it has not settled by
  # the next run the branch above reports it.
  touch "$cstate"
fi

docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$SENSOR_CONTAINER" \
  || report "SENSOR DOWN (${SENSOR_CONTAINER} not running)"

unhealthy=$(cd "$MALCOLM_DIR" && docker compose ps --format '{{.Name}} {{.Status}}' 2>/dev/null \
            | grep -viE 'healthy|Up [0-9]+ (second|minute)s? \(health: starting\)' | head -3)
[[ -n "$unhealthy" ]] && report "UNHEALTHY: $(echo "$unhealthy" | tr '\n' ';')"

# Newest capture that reached processed/, as epoch seconds.
newest=$(docker run --rm -v "${PCAP_MOUNT}:/p" alpine sh -c \
  'ls -t /p/processed/*.pcap 2>/dev/null | head -1 | xargs -r stat -c %Y' 2>/dev/null)

# When the publisher last announced a file to the analysers.
last_pub=$(docker logs --since 30m "$MONITOR_CONTAINER" 2>&1 | grep -F '📫' | tail -1 \
           | grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}')
last_pub_epoch=$([[ -n "$last_pub" ]] && date -u -d "$last_pub" +%s 2>/dev/null || echo 0)

if [[ -n "${newest:-}" && "${newest:-0}" -gt 0 ]]; then
  lag=$(( newest - last_pub_epoch ))
  if [[ "$last_pub_epoch" -eq 0 || "$lag" -gt "$STALL_SECS" ]]; then

    # This path had no rate limit, and the lag it measures cannot fall while a
    # restart is in progress: `newest` keeps advancing with every new capture
    # while the restarted publisher spends its first 60s in --start-sleep. So a
    # publisher that is merely slower than the arrival rate got restarted on
    # every run, and each restart threw away the progress it had made. That is
    # the restart-loop failure this file already warns about, in the one branch
    # that had no protection against it.
    pstate="${STATE_DIR}/publisher.restarted"
    plast=0; [[ -f "$pstate" ]] && plast=$(cat "$pstate" 2>/dev/null || echo 0)
    psince=$(( $(date -u +%s) - plast ))

    if [[ "$plast" -gt 0 && "$psince" -lt "${RESTART_GRACE_SECS:-120}" ]]; then
      : # restarted moments ago and still warming up; not a finding yet
    elif [[ "$plast" -gt 0 && "$psince" -lt "${RESTART_ESCALATE_SECS:-900}" ]]; then
      # Already restarted once this incident and it did not take. Restarting
      # again only resets the clock, so stop and escalate to a human instead.
      report "PUBLISHER STILL STALLED ${psince}s after a restart (lag ${lag}s) - NOT restarting again"
      echo "  a second restart cannot help: it re-enters --start-sleep and drops progress."
      echo "  if this persists, re-present the unpublished captures to the watcher with:"
      echo "    tools/watchdog --heal   # after the ${RESTART_ESCALATE_SECS:-900}s window, or investigate by hand"
    else
      report "PUBLISHER STALLED (captures arriving, last publish ${lag}s older than newest capture)"
      if [[ "$HEAL" -eq 1 ]]; then
        echo "  healing: restarting ${MONITOR_CONTAINER}"
        if (cd "$MALCOLM_DIR" && docker compose --profile malcolm restart pcap-monitor >/dev/null 2>&1); then
          date -u +%s > "$pstate"
          echo "  restarted - will not restart again for ${RESTART_ESCALATE_SECS:-900}s"
        fi
      fi
    fi
  else
    # Publishing again: this incident is over, so a future stall starts clean.
    rm -f "${STATE_DIR}/publisher.restarted"
  fi
fi

# Queue-age checks. The pipeline is a chain of spool directories, each drained
# by a watcher process, and EVERY one of those watchers has been observed to
# stop silently while alive and healthy. Checking only one stage misses the
# others - this was learned by fixing the pcap publisher and then finding
# filebeat's zeek-tarball extractor stalled in exactly the same way.
#
# Depth alone is a bad signal: a deep queue that is moving is fine. The age of
# the OLDEST pending item is the honest one - if nothing has drained the head of
# the queue in STALL_SECS, that stage is stuck.
# Move files out of a spool directory and back, so the watcher sees them as
# newly created. This is the ONLY thing that clears the created-events trap - a
# restart leaves them just as pre-existing as before.
requeue() { # requeue <mount> <glob-dir>
  local mount="$1" dir="$2" parent
  parent="$(dirname "$dir")"
  docker run --rm -v "${mount}:/q" alpine sh -c \
    "mkdir -p /q/.requeue
     for f in /q/${dir}; do [ -f \"\$f\" ] || continue; mv \"\$f\" /q/.requeue/ 2>/dev/null; done
     sleep 20
     for f in /q/.requeue/*; do [ -f \"\$f\" ] || continue; mv \"\$f\" /q/${parent}/ 2>/dev/null; done
     rmdir /q/.requeue 2>/dev/null; true" >/dev/null 2>&1
}

check_queue() { # check_queue <label> <mount> <glob-dir> <service-to-restart>
  local label="$1" mount="$2" dir="$3" svc="$4"
  local oldest count
  # Age comes from the capture timestamp in the FILENAME, not mtime. mtime is
  # not trustworthy here: touching a stuck file resets it, which hides the stall
  # from this very check while the file remains stuck. (Learned the hard way -
  # touch also does not unstick it, see GOTCHAS.)
  read -r count oldest < <(docker run --rm -v "${mount}:/q" alpine sh -c \
    "ls -1 /q/${dir} 2>/dev/null | wc -l
     for f in \$(ls -1 /q/${dir} 2>/dev/null); do
       b=\$(basename \"\$f\"); case \"\$b\" in
         *20[0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]*)
           echo \"\$b\" | sed 's/.*\\(20[0-9]\\{6\\}\\)-\\([0-9]\\{6\\}\\).*/\\1\\2/' ;;
         *) date -u -r \"\$f\" +%Y%m%d%H%M%S 2>/dev/null || stat -c %Y \"\$f\" ;;
       esac
     done | sort | head -1" 2>/dev/null | paste -sd' ')
  [[ -z "${oldest:-}" || "${#oldest}" -ne 14 ]] && return 0
  local oldest_epoch age
  oldest_epoch=$(date -u -d "${oldest:0:8} ${oldest:8:2}:${oldest:10:2}:${oldest:12:2}" +%s 2>/dev/null) || return 0
  age=$(( $(date -u +%s) - oldest_epoch ))
  [[ "$age" -le "$STALL_SECS" ]] && return 0

  # A deep queue is not the same as a stopped one. After a stall the backlog can
  # be hours old while the consumer works through it perfectly well - restarting
  # then is actively harmful: each restart costs the startup delay and drops
  # whatever was in flight, so a 5-minute heal loop can keep a queue permanently
  # backlogged. Only restart when nothing is draining.
  local drained
  drained=$(docker logs --since 5m "$(drain_container "$svc")" 2>&1 | grep -cE '🖅|📫' || true)

  # ORDER MATTERS HERE. A stuck head has two different causes needing opposite
  # repairs, and the discriminator is whether the consumer is doing anything at
  # all:
  #
  #   no events at all  -> the watcher has wedged      -> restart it
  #   events flowing    -> created-events trap         -> re-queue the strays
  #
  # Getting this backwards re-queues files at a dead consumer, which changes
  # nothing and looks like the repair failed. (It did exactly that once: the
  # mover had silently stopped for the third time, and re-queuing was a no-op
  # because nothing was left to notice the new files.)
  if [[ "${drained:-0}" -eq 0 ]]; then
    # A restart only helps a genuinely wedged watcher. If the queue holds files
    # that were ALREADY there when it started, the restarted watcher treats them
    # as pre-existing and ignores them exactly as the old one did - so drain
    # stays 0, this fires again, and it restarts forever without ever making
    # progress. Observed live: five captures stranded through repeated restarts
    # while new ones piled up behind them.
    #
    # So restart once, then escalate. If drain is still 0 after a recent
    # restart, the problem is the files, not the process.
    local rstate="${STATE_DIR}/$(echo "$label" | tr '/' '_').restarted"
    local last_restart=0
    [[ -f "$rstate" ]] && last_restart=$(cat "$rstate" 2>/dev/null || echo 0)
    local since_restart=$(( $(date -u +%s) - last_restart ))

    # A restart needs time before "no events" means anything: pcap_watcher runs
    # --start-sleep 60 and the mover --start-sleep 30, so a freshly restarted
    # consumer is silent BY DESIGN. Without a floor here, a check landing shortly
    # after a restart reads that designed silence as "the restart did not help"
    # and escalates to a re-queue that was never needed. Seen for real at
    # since_restart=5s, when two checks interleaved.
    #
    # So escalate only inside a window: old enough to have had a fair chance,
    # recent enough that it is still the same incident.
    if [[ "$last_restart" -gt 0 && "$since_restart" -lt "${RESTART_GRACE_SECS:-120}" ]]; then
      # Still warming up. Not a problem yet, and emphatically not a re-queue.
      return 0
    fi

    if [[ "$last_restart" -gt 0 && "$since_restart" -lt "${RESTART_ESCALATE_SECS:-900}" ]]; then
      report "QUEUE STALLED: ${label} (${count} pending, ${age}s old; restart ${since_restart}s ago did not help - files are stranded, not the process)"
      if [[ "$HEAL" -eq 1 ]]; then
        echo "  healing: re-queuing (restart cannot clear pre-existing files)"
        requeue "$mount" "$dir"
        : > "$rstate"   # clear, so a genuine wedge can still earn a restart later
      fi
      return 0
    fi

    report "QUEUE STALLED: ${label} (${count} pending, oldest capture ${age}s old, consumer produced no events)"
    if [[ "$HEAL" -eq 1 && -n "$svc" ]]; then
      echo "  healing: restarting ${svc}"
      (cd "$MALCOLM_DIR" && docker compose --profile malcolm restart "$svc" >/dev/null 2>&1)
      date -u +%s > "$rstate"
    fi
    return 0
  fi

  # Consumer is alive and emitting, but "draining" is not the same as "making
  # progress". The watchers act on *created* events, so anything already present
  # when one starts is skipped forever while new arrivals sail past it. The queue
  # looks busy and healthy - events flowing, count roughly stable - with a
  # permanently stranded head. 68 tarballs sat like that for four hours.
  #
  # The tell is the OLDEST entry never changing. Track it across runs.
  local state="${STATE_DIR}/$(echo "$label" | tr '/' '_').oldest"
  local prev=""; [[ -f "$state" ]] && prev=$(cat "$state")
  echo "$oldest" > "$state"

  if [[ -n "$prev" && "$prev" == "$oldest" && "$count" -gt 0 ]]; then
    report "QUEUE HEAD STUCK: ${label} (${count} pending, head unchanged at ${oldest}, ${age}s old)"
    # A restart does NOT fix this - the files are still pre-existing to the
    # restarted watcher. Re-present them as new instead.
    if [[ "$HEAL" -eq 1 ]]; then
      echo "  healing: re-queuing stranded entries in ${label}"
      requeue "$mount" "$dir"
      echo "  re-queued - watchers see them as new files now"
    fi
    return 0
  fi

  # Only claim the head is advancing when that has actually been OBSERVED, i.e.
  # this is not the first sighting and the oldest entry changed since last run.
  # It used to assert "head advancing" on the first sighting too, which is a
  # claim about something it had not checked - and it is wrong in the exact case
  # that matters: the mover happily drains new arrivals past a stranded head, so
  # events flow, the count looks stable, and the report says everything is fine
  # while the oldest capture sits there. Seen live at 17 minutes stuck.
  local head_state
  if [[ -z "$prev" ]]; then
    head_state="head not yet re-checked - if it has not moved by the next run this is a stranded head"
  else
    head_state="head advancing"
  fi

  if [[ "${drained:-0}" -gt 0 ]]; then
    report "QUEUE BACKLOG: ${label} (${count} pending, oldest capture ${age}s old; draining - ${drained} events/5m, ${head_state})"
    return 0
  fi

  report "QUEUE BACKLOG: ${label} (${count} pending, oldest capture ${age}s old; ${head_state})"
}

drain_container() { # map a compose service to its container name
  case "$1" in
    pcap-monitor) echo "$MONITOR_CONTAINER" ;;
    *)            echo "${COMPOSE_PROJECT}-${1}-1" ;;
  esac
}

check_queue "pcap/upload"      "$PCAP_MOUNT" "upload/*.pcap"    "pcap-monitor"
check_queue "zeek-logs/upload" "$ZEEK_MOUNT" "upload/*.tar.gz" "filebeat"

exit $(( problems > 0 ))
