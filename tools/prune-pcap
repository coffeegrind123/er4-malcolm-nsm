#!/usr/bin/env bash
# Time-bound the raw PCAP archive.
#
#   tools/prune-pcap            delete captures older than PCAP_RETENTION_DAYS
#   tools/prune-pcap --dry-run  show what would go, delete nothing
#
# Why time and not size. Arkime's own ARKIME_FREESPACEG prunes on free space,
# which on a large disk never triggers - and even when it does, it caps bytes
# rather than file count. At ~5 MB per capture a 300 GB cap still leaves ~56,000
# files in one directory, and pcap/processed is polled by pcap_watcher on every
# cycle. Scan cost tracks the file COUNT, so only a time bound actually holds it
# still.
#
# What this does NOT touch: session metadata in OpenSearch, which has its own
# 90-day ISM policy. Pruning here costs you the ability to pull raw packets for
# an old session; the session, its fields and every dashboard still work.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[[ -f "${REPO_ROOT}/config.env" ]] && source "${REPO_ROOT}/config.env"

DAYS="${PCAP_RETENTION_DAYS:-14}"
PCAP_MOUNT="${PCAP_MOUNT:-//d/malcolm-data/pcap}"
OSAPI="${REPO_ROOT}/tools/osapi"
DRY=0; [[ "${1:-}" == "--dry-run" ]] && DRY=1

say() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
ok()  { printf '    \033[32mok\033[0m   %s\n' "$*"; }

# Quarantine, from sensor/rotate.sh. Nothing else prunes it and nothing polls
# it, so left alone it grows forever - the exact failure this script exists to
# prevent, just in a directory nobody looks at.
#
# It gets its OWN, longer bound. These captures are quarantined because they are
# anomalous, they are the only copy of whatever burst produced them, and they
# are kept deliberately for manual handling - so they should outlive the routine
# archive rather than share its retention.
#
# This runs on EVERY exit path, including "nothing to prune" and --dry-run.
# Reporting the footprint unconditionally is the point: silent accumulation in a
# directory nobody watches is what went wrong the first time.
quarantine_pass() {
  local qdays qstate qcutoff qdel
  qdays="${QUARANTINE_RETENTION_DAYS:-30}"
  qstate=$(docker run --rm -v "${PCAP_MOUNT}:/p" alpine sh -c \
    'echo "$(ls -1 /p/quarantine/*.pcap 2>/dev/null | wc -l) files, $(du -sh /p/quarantine 2>/dev/null | cut -f1)"' 2>/dev/null)
  ok "quarantine: ${qstate:-0 files} (retention ${qdays}d)"

  qcutoff=$(date -u -d "${qdays} days ago" +%Y%m%d%H%M%S)
  if [[ $DRY -eq 1 ]]; then
    qdel=$(docker run --rm -v "${PCAP_MOUNT}:/p" alpine sh -c "
      n=0
      for f in /p/quarantine/*.pcap; do
        [ -f \"\$f\" ] || continue
        ts=\$(basename \"\$f\" | sed -n 's/.*\\(20[0-9]\\{6\\}\\)-\\([0-9]\\{6\\}\\).*/\\1\\2/p')
        [ -n \"\$ts\" ] || continue
        [ \"\$ts\" -lt ${qcutoff} ] && n=\$((n+1))
      done
      echo \$n" 2>/dev/null || echo 0)
    [[ "${qdel:-0}" -gt 0 ]] && ok "quarantine: ${qdel} capture(s) would be deleted"
    return 0
  fi

  qdel=$(docker run --rm -v "${PCAP_MOUNT}:/p" alpine sh -c "
    n=0
    for f in /p/quarantine/*.pcap; do
      [ -f \"\$f\" ] || continue
      ts=\$(basename \"\$f\" | sed -n 's/.*\\(20[0-9]\\{6\\}\\)-\\([0-9]\\{6\\}\\).*/\\1\\2/p')
      [ -n \"\$ts\" ] || continue
      [ \"\$ts\" -lt ${qcutoff} ] && rm -f \"\$f\" && n=\$((n+1))
    done
    echo \$n" 2>/dev/null || echo 0)
  [[ "${qdel:-0}" -gt 0 ]] && ok "quarantine: deleted ${qdel} capture(s) older than ${qdays}d"
  return 0
}

say "PCAP retention: ${DAYS} days$( [[ $DRY -eq 1 ]] && echo '  (dry run)')"

# Age comes from the capture timestamp in the filename, not mtime. mtime is
# rewritten by the re-queue repair that clears stranded files, which would make
# a freshly-repaired capture look brand new and exempt it forever.
CUTOFF=$(date -u -d "${DAYS} days ago" +%Y%m%d%H%M%S)
ok "deleting captures with a timestamp before ${CUTOFF}"

LIST=$(docker run --rm -v "${PCAP_MOUNT}:/p" alpine sh -c "
  for f in /p/processed/*.pcap; do
    [ -f \"\$f\" ] || continue
    b=\$(basename \"\$f\")
    ts=\$(echo \"\$b\" | sed -n 's/.*\\(20[0-9]\\{6\\}\\)-\\([0-9]\\{6\\}\\).*/\\1\\2/p')
    [ -n \"\$ts\" ] || continue
    [ \"\$ts\" -lt ${CUTOFF} ] && echo \"\$b\"
  done" 2>/dev/null || true)

COUNT=$(printf '%s' "$LIST" | grep -c . || true)
TOTAL=$(docker run --rm -v "${PCAP_MOUNT}:/p" alpine sh -c 'ls -1 /p/processed/*.pcap 2>/dev/null | wc -l' 2>/dev/null || echo 0)

if [[ "${COUNT:-0}" -eq 0 ]]; then
  ok "nothing older than ${DAYS} days (${TOTAL} captures retained)"
  quarantine_pass
  exit 0
fi

ok "${COUNT} of ${TOTAL} captures are older than ${DAYS} days"
printf '%s\n' "$LIST" | head -3 | sed 's/^/      /'
[[ "$COUNT" -gt 3 ]] && echo "      ... and $((COUNT - 3)) more"

if [[ $DRY -eq 1 ]]; then
  say "Dry run - nothing deleted."
  quarantine_pass
  exit 0
fi

# Remove Arkime's index entries first. Doing it the other way round leaves a
# window where the UI offers a PCAP download for a file that is already gone.
printf '%s\n' "$LIST" | while read -r b; do
  [[ -n "$b" ]] || continue
  "$OSAPI" es POST 'arkime_files/_delete_by_query' \
    "{\"query\":{\"wildcard\":{\"name\":\"*${b}\"}}}" >/dev/null 2>&1 || true
done
ok "arkime_files entries removed"

printf '%s\n' "$LIST" | docker run --rm -i -v "${PCAP_MOUNT}:/p" alpine sh -c '
  n=0; while read -r b; do
    [ -n "$b" ] || continue
    rm -f "/p/processed/$b" && n=$((n+1))
  done; echo "    deleted $n capture files"'

REMAIN=$(docker run --rm -v "${PCAP_MOUNT}:/p" alpine sh -c 'echo "$(ls -1 /p/processed/*.pcap 2>/dev/null | wc -l) files, $(du -sh /p/processed 2>/dev/null | cut -f1)"' 2>/dev/null)
ok "archive now: ${REMAIN}"

quarantine_pass
