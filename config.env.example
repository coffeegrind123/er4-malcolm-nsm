# Copy to config.env and edit. Every script sources this file.

# ---- Router (capture sensor) -------------------------------------------------
ROUTER_HOST=192.168.1.1
ROUTER_USER=admin
# Interface to capture on. Use the LAN bridge, not the WAN interface: the bridge
# carries every routed flow and preserves pre-NAT LAN source addresses, which the
# WAN side has already masqueraded behind a single IP.
CAPTURE_IFACE=br0

# ---- Collector ---------------------------------------------------------------
# The address the router sees the collector as. Used to build the BPF rule that
# excludes the capture transport from its own capture.
COLLECTOR_IP=192.168.1.100

# 0 = full packet capture. 512 keeps headers, DNS and TLS SNI at roughly 10-20x
# less volume - enough to answer "who talked to what", not enough for payload search.
SNAPLEN=0
# Seconds per PCAP file. Ingest latency is roughly one rotation.
ROTATE_SECS=60
# Router-side libpcap buffer in KiB. Raise if tcpdump reports kernel drops.
RBUF=8192

# ---- Malcolm -----------------------------------------------------------------
MALCOLM_VERSION=v26.07.1
MALCOLM_DIR="${HOME}/malcolm"
MALCOLM_ADMIN_USER=admin

# JVM heaps. Malcolm's own configure sizes these against *total* system RAM and
# will happily allocate more than is free. Size them against what is actually
# available or OpenSearch will OOM or swap.
OPENSEARCH_HEAP=6g
LOGSTASH_HEAP=2048m

# Keep this many GB free before Arkime starts deleting the oldest PCAP.
ARKIME_FREESPACEG=500

# Enable OpenSearch Dashboards' enhanced Discover experience: multiple data
# sources, workspaces, and the Explore UI. Adds navigation Malcolm's curated
# dashboards do not use, so set false if you prefer the stock layout.
OSD_ENHANCED_DISCOVER=true

# ---- Storage -----------------------------------------------------------------
# Bulk data (PCAP, OpenSearch indices, Zeek/Suricata logs). Full-packet capture
# runs tens of GB per day - put this on your largest volume.
DATA_ROOT=/d/malcolm-data

# ---- Docker Desktop on Windows ----------------------------------------------
# Set true when the Docker engine is Docker Desktop backed by a Windows host.
# It changes how bind-mount sources are written, which is not cosmetic: relative
# and Linux-style paths resolve to a DIFFERENT, EMPTY view of the filesystem, so
# containers silently start against empty directories.
DOCKER_DESKTOP_WINDOWS=true
# Windows-side location of MALCOLM_DIR, in Docker Desktop notation.
MALCOLM_DIR_WIN=//c/Users/YOU/malcolm
# Windows-side location of DATA_ROOT.
DATA_ROOT_WIN=//d/malcolm-data
# Windows-side location of this repo's key directory (mounted into the sensor).
KEYS_DIR_WIN=//c/Users/YOU/er4-malcolm-nsm/keys
